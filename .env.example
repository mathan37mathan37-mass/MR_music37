# MR Music — Environment Variables
# Copy this file to .env and fill in your Supabase credentials.
# NEVER commit .env or .env.local to git.

# ── Supabase (Backend: Auth, PostgreSQL, Storage) ─────────────────────────────
# Get these from: https://supabase.com/dashboard → Project Settings → API
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_anon_key"

# Admin PIN — only evaluated in demo simulation mode (no Supabase configured).
# When Supabase is active, admin access is controlled securely by profiles.role = 'admin'.
VITE_ADMIN_PIN="your_admin_pin"

# MR Music — Environment Variables
# Copy this file to .env and fill in your credentials.
# NEVER commit .env or .env.local to git.

# ── Firebase (legacy / fallback) ──────────────────────────────────────────────
VITE_FIREBASE_API_KEY="your_firebase_api_key"
VITE_FIREBASE_AUTH_DOMAIN="your_project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your_project_id"
VITE_FIREBASE_STORAGE_BUCKET="your_project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_sender_id"
VITE_FIREBASE_APP_ID="your_app_id"

# ── Supabase (primary backend) ────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project Settings → API
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_anon_key"

# Admin PIN — only evaluated in demo mode (no Supabase / Firebase configured).
# When Supabase is active, admin access is controlled by profiles.role = 'admin'.
VITE_ADMIN_PIN="your_admin_pin"
